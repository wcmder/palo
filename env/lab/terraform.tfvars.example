# Two spokes sharing one device group. Replace documentation addresses before deployment.
# Leave serials empty to create the Panorama configuration without assigning a firewall.
spokes = {
  spoke01 = {
    policy = {
      device_group = "lab-spoke"
    }
    template = {
      name        = "lab-spoke-network"
      stack       = "lab-spoke-stack"
      description = "Terraform-managed spoke"
      var = {
        wan_interface     = "ethernet1/1"
        lan_interface     = "ethernet1/2"
        wan_zone          = "wan"
        lan_zone          = "lan"
        wan_ip            = "192.0.2.2"
        wan_prefix_length = 30
        lan_ip            = "198.51.100.1"
        lan_prefix_length = 24
        default_gateway   = "192.0.2.1"
        virtual_router    = "spoke-vr"
      }
    }
    serials = []
  }
  spoke02 = {
    policy = {
      device_group = "lab-spoke" # Shared with spoke01.
    }
    template = {
      name        = "lab-spoke-b-network"
      stack       = "lab-spoke-b-stack"
      description = "Terraform-managed spoke"
      var = {
        wan_interface     = "ethernet1/1"
        lan_interface     = "ethernet1/2"
        wan_zone          = "wan"
        lan_zone          = "lan"
        wan_ip            = "192.0.2.6"
        wan_prefix_length = 30
        lan_ip            = "203.0.113.1"
        lan_prefix_length = 24
        default_gateway   = "192.0.2.5"
        virtual_router    = "spoke-vr"
      }
    }
    serials = []
  }

}

# Shared template/stack alternative: use one entry with both serials.
# Set template.var.wan_ip, lan_ip and default_gateway to "None",
# and omit the prefixes or set them to null. Assign per-device values with
# device_overrides.json and palo lab overrides plan/apply before commit/push.
