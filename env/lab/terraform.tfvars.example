# Two spokes sharing one device group. Replace documentation addresses before deployment.
# Leave serials empty to create the Panorama configuration without assigning a firewall.
spokes = {
  spoke01 = {
    policy = {
      device_group = "lab-spoke"
    }
    template = {
      name  = "lab-spoke-network"
      stack = "lab-spoke-stack"
      var = {
        wan_ip = {
          description = "WAN interface IPv4 address and prefix length"
          type = {
            ip_netmask = "192.0.2.2/30"
          }
        }
        lan_ip = {
          description = "LAN interface IPv4 address and prefix length"
          type = {
            ip_netmask = "198.51.100.1/24"
          }
        }
        default_gateway = {
          description = "WAN next hop for the IPv4 default route"
          type = {
            ip_netmask = "192.0.2.1"
          }
        }
      }
      interfaces = {
        wan = {
          name    = "ethernet1/1"
          comment = "WAN interface"
          layer3 = {
            ips = [{
              name = "$wan_ip"
            }]
          }
        }
        lan = {
          name    = "ethernet1/2"
          comment = "LAN interface"
          layer3 = {
            ips = [{
              name = "$lan_ip"
            }]
          }
        }
      }
      zones = {
        wan = {
          name = "wan"
          network = {
            layer3 = ["ethernet1/1"]
          }
        }
        lan = {
          name = "lan"
          network = {
            layer3 = ["ethernet1/2"]
          }
        }
      }
      routers = {
        spoke = {
          name       = "spoke-vr"
          interfaces = ["ethernet1/1", "ethernet1/2"]
        }
      }
      routes = {
        default = {
          virtual_router = "spoke-vr"
          destination    = "0.0.0.0/0"
          interface      = "ethernet1/1"
          metric         = 10
          nexthop = {
            ip_address = "$default_gateway"
          }
          route_table = {
            unicast = {}
          }
        }
      }
    }
    serials = []
  }
  spoke02 = {
    policy = {
      device_group = "lab-spoke" # Shared with spoke01.
    }
    template = {
      name  = "lab-spoke-b-network"
      stack = "lab-spoke-b-stack"
      var = {
        wan_ip = {
          description = "WAN interface IPv4 address and prefix length"
          type = {
            ip_netmask = "192.0.2.6/30"
          }
        }
        lan_ip = {
          description = "LAN interface IPv4 address and prefix length"
          type = {
            ip_netmask = "203.0.113.1/24"
          }
        }
        default_gateway = {
          description = "WAN next hop for the IPv4 default route"
          type = {
            ip_netmask = "192.0.2.5"
          }
        }
      }
      interfaces = {
        wan = {
          name    = "ethernet1/1"
          comment = "WAN interface"
          layer3 = {
            ips = [{
              name = "$wan_ip"
            }]
          }
        }
        lan = {
          name    = "ethernet1/2"
          comment = "LAN interface"
          layer3 = {
            ips = [{
              name = "$lan_ip"
            }]
          }
        }
      }
      zones = {
        wan = {
          name = "wan"
          network = {
            layer3 = ["ethernet1/1"]
          }
        }
        lan = {
          name = "lan"
          network = {
            layer3 = ["ethernet1/2"]
          }
        }
      }
      routers = {
        spoke = {
          name       = "spoke-vr"
          interfaces = ["ethernet1/1", "ethernet1/2"]
        }
      }
      routes = {
        default = {
          virtual_router = "spoke-vr"
          destination    = "0.0.0.0/0"
          interface      = "ethernet1/1"
          metric         = 10
          nexthop = {
            ip_address = "$default_gateway"
          }
          route_table = {
            unicast = {}
          }
        }
      }
    }
    serials = []
  }

}

# Optional foundation-only sites: creates containers and address objects,
# without interface, zone, routing, or template-variable configuration.
# Use sites = {} (or omit it) if only the spoke configuration is needed.
# Names and assigned firewall serials must not overlap with the spokes map.
# The lab deployment actions currently target spokes only, not sites.
sites = {
  site01 = {
    device_group   = "lab-site01"
    template       = "lab-site01-network"
    template_stack = "lab-site01-stack"
    description    = "Foundation-only lab site"
    serials        = [] # Optional: serial numbers of already managed firewalls.
    addresses = {
      "site01-lan"    = "203.0.113.0/25"
      "site01-server" = "203.0.113.130/32"
    }
  }
}


