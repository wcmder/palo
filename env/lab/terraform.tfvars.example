# var.dmz_ip = { type = { ip_netmask = "None" } }
# interfaces.dmz = { name = "ethernet1/3", layer3 = { ips = [{ name = "$dmz_ip" }] } }
# zones.dmz = { network = { layer3 = ["ethernet1/3"] } }
# Also add "ethernet1/3" to the relevant routers.<key>.interfaces list.
# The dotted paths above describe entries to add inside the existing maps.
