# A/B/C can represent 300/500/200 firewalls. Add real serials to their child groups.
# parent=null explicitly manages the group under Panorama Shared.
device_groups = {
  parent_a   = { parent = null, serials = [] }
  parent_b   = { parent = null, serials = [] }
  parent_c   = { parent = null, serials = [] }
  branches_a = { parent = "parent_a", serials = ["PA_A_SERIAL"] }
  branches_b = { parent = "parent_b", serials = ["PA_B_SERIAL"] }
  branches_c = { parent = "parent_c", serials = ["PA_C_SERIAL"] }
  hubs_a     = { parent = "parent_a", serials = ["HUB_A_SERIAL"] }
}
